---
import { Icon } from "astro-icon/components";
import Badge from "./ui/Badge.astro";
import GradientText from "./ui/GradientText.astro";
import ContactForm from "./ui/ContactForm.astro";
import { siteConfig } from "../data/site";

const contactData = [
  {
    id: "email",
    title: "Escribime un correo",
    description: siteConfig.email,
    link: `mailto:${siteConfig.email}`,
    icon: "ri:mail-fill",
  },
  {
    id: "whatsapp",
    title: "WhatsApp",
    description: siteConfig.phone,
    link: siteConfig.whatsappUrl,
    icon: "ri:phone-fill",
  },
  {
    id: "location",
    title: "Ubicación",
    description: `${siteConfig.address[0]}, ${siteConfig.address[1]}`,
    icon: "ri:map-pin-fill",
  },
];
---

<section
  id="contact"
  class="py-24 bg-void border-t border-primary/10 relative overflow-hidden reveal"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,var(--tw-gradient-stops))] from-primary/20 via-surface to-surface -z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="text-center max-w-3xl mx-auto mb-12 p-4 rounded-2xl border border-primary/20 bg-primary/5"
    >
      <p class="text-ivory font-mono text-sm">
        <span class="text-primary">★</span> Respuesta en menos de 24h ·
        +5 años de experiencia · Garantía 30 días en cada proyecto
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">
      <div>
        <Badge text="Hablemos" variant="secondary" />
        <h2 class="text-3xl md:text-5xl font-bold mb-6 reveal font-heading">
          Te respondo en <GradientText>menos de 24 horas.</GradientText>
        </h2>
        <p class="text-lg text-muted mb-10 leading-relaxed max-w-lg font-mono">
          Elegí el canal que prefieras. Sin formularios eternos, sin
          intermediarios. Directo conmigo.
        </p>

        <div class="space-y-8">
          {
            contactData.map((contact) => (
              <div class="flex items-start gap-4 group">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                  <Icon name={contact.icon} class="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h3 class="text-ivory font-medium mb-1 text-lg">
                    {contact.title}
                  </h3>
                  {contact.id === "location" ? (
                    <p class="text-muted font-mono">{contact.description}</p>
                  ) : (
                    <a
                      href={contact.link}
                      class="text-muted font-mono hover:text-primary transition-colors"
                    >
                      {contact.description}
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="bg-surface p-8 md:p-10 rounded-3xl border border-primary/10 shadow-2xl relative"
      >
        <div
          class="absolute -top-24 -right-24 w-48 h-48 bg-primary/30 rounded-full blur-3xl pointer-events-none"
        >
        </div>

        <ContactForm
          showHeader={false}
          showPrivacy={true}
          btnTexto="Enviar mensaje"
          className="relative z-10"
        />
      </div>
    </div>
  </div>
</section>
