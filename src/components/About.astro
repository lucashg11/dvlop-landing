---
import { Image } from "astro:assets";
import { ICONS } from "../data/icons";
import aboutImage from "../assets/images/profile-3.png";
import { values } from "../data/about";

const features = [
  "+5 años de experiencia en desarrollo web",
  "HTML · CSS · JS · Astro · MERN",
  "Sitios entregados en 7 a 25 días según alcance",
  "Comunicación directa por WhatsApp, sin intermediarios",
];

const whatsappHref = `https://wa.me/5493487314587?text=${encodeURIComponent("Hola Lucas, vengo de tu web y quiero contarte sobre mi proyecto.")}`;
---

<section
  id="about"
  class="py-24 bg-void border-t border-primary/10 reveal"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <div
          class="absolute inset-0 bg-primary rounded-3xl blur-3xl opacity-20 -z-10"
        >
        </div>
        <Image
          src={aboutImage}
          alt="Lucas, desarrollador web freelance en Zárate, Buenos Aires"
          loading="eager"
          class="rounded-3xl shadow-2xl border border-primary/10 object-cover aspect-square w-full"
        />
        <div
          class="absolute -bottom-6 -right-6 bg-surface border border-primary/10 p-6 rounded-2xl shadow-xl hidden sm:block"
        >
          <div class="text-4xl font-extrabold text-primary mb-1 font-display">
            +5
          </div>
          <div class="text-ivory font-medium">Años de experiencia</div>
        </div>
      </div>

      <div>
        <p class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest">
          Por qué trabajar conmigo
        </p>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 reveal font-heading">
          Hola, soy Lucas.
        </h2>
        <p class="text-lg text-ivory mb-6 leading-relaxed font-mono">
          Soy desarrollador web. Hace 5+ años ayudo a negocios locales,
          emprendedores y PyMEs a dejar de depender solo de redes sociales y
          aparecer en Google cuando alguien busca lo que hacen.
        </p>
        <p class="text-base text-muted mb-10 leading-relaxed font-mono">
          Trabajo con Astro, Tailwind CSS y JavaScript para sitios rápidos, y
          con React + Node + MongoDB cuando necesitás algo más complejo. Pero
          la tecnología es lo de menos: lo que importa es que cada sitio
          resuelva un problema concreto de tu negocio. Sin plantillas, sin
          intermediarios, comunicación directa.
        </p>

        <div class="space-y-3 mb-10">
          {
            features.map((feature) => (
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-success shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                <span class="text-ivory font-mono text-sm">{feature}</span>
              </div>
            ))
          }
        </div>
        <div class="grid md:grid-cols-3 gap-4 mb-10 md:w-2xl">
          {
            values.map((value) => {
              const Icon = ICONS[value.icon];
              return (
                <div class="bg-surface border border-primary/10 rounded-2xl p-5 ">
                  <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center mb-3">
                    {Icon && <Icon class="w-5 h-5 text-primary" />}
                  </div>
                  <h3 class="text-base font-bold font-heading mb-2">
                    {value.title}
                  </h3>
                  <p class="text-muted text-xs font-mono leading-relaxed">
                    {value.description}
                  </p>
                </div>
              );
            })
          }
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-cta-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
        >
          Hablemos por WhatsApp
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
