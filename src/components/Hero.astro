---
import GradientText from "./ui/GradientText.astro";
import { siteConfig } from "../data/site";

const whatsappHref = `${siteConfig.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, vengo de tu web y quiero reservar 15 minutos para hablar de mi proyecto.")}`;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden reveal"
>
  <div class="absolute inset-0 -z-10 overflow-hidden bg-void">
    <div class="absolute inset-0 bg-grid-pattern opacity-60"></div>
    <div class="absolute inset-0 bg-dot-pattern opacity-40"></div>
    <div
      class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary/20 rounded-full blur-[120px] animate-orb-float"
    >
    </div>
    <div
      class="absolute bottom-[10%] right-[-5%] w-[30%] h-[30%] bg-primary/10 rounded-full blur-[100px] animate-orb-float"
      style="animation-delay: -5s;"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('../assets/images/noise.svg')]"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-success/10 border border-success/20 text-success text-sm font-medium mb-8 animate-fade-in-up"
      >
        <span class="flex h-2 w-2 relative">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-success"
          ></span>
        </span>
        Disponible para 2 proyectos este mes
      </div>

      <h1
        class="text-3xl md:text-6xl font-extrabold tracking-tight mb-8 animate-fade-in-up animate-delay-100 font-display"
      >
        Tu próximo cliente te está buscando en <GradientText>Google</GradientText>. <br> <GradientText>No te encuentra.</GradientText>
      </h1>

      <p
        class="text-lg font-mono md:text-xl text-muted max-w-xl mb-10 animate-fade-in-up animate-delay-200"
      >
        Creo sitios web rápidos, optimizados para Google y diseñados para convertir
        visitas en consultas. Comunicación directa por
        WhatsApp, sin jerga.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animate-delay-300"
      >
        <a
          href="#process"
          class="flex items-center justify-center gap-2 bg-cta-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
        >
          Ver cómo trabajo
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 bg-surface hover:bg-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all border border-primary/20"
        >
          Reservar 15 min por WhatsApp
        </a>
      </div>

      <div
        class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 text-muted text-sm font-mono animate-fade-in-up animate-delay-400"
      >
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4 text-success"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path></svg
          >
          +5 años de experiencia
        </span>
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4 text-success"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path></svg
          >
          Respuesta en menos de 24h
        </span>
        <span class="flex items-center gap-2">
          <svg
            class="w-4 h-4 text-success"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path></svg
          >
          Garantía 30 días
        </span>
      </div>
    </div>
  </div>
</section>
