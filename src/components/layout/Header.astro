---
import { Icon } from "astro-icon/components";
import { mainNav, site } from "@config/site";

const whatsappHref = `${site.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, te escribo desde tu web. Quiero contarte brevemente qué necesito para mi negocio y ver si tiene sentido trabajar juntos.")}`;
---

<header
    class="fixed top-0 w-full z-50 glass border-b border-primary/10 transition-all duration-300"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a href="/" class="shrink-0 flex items-center gap-2">
                <p
                    class="font-mono font-extrabold text-2xl tracking-tight text-ivory"
                >
                    LUCAS<span
                        class="bg-linear-to-r from-primary to-accent text-transparent bg-clip-text"
                        >&lt;&#47;DEV&gt;</span
                    >
                </p>
            </a>
            <nav class="hidden md:flex space-x-8">
                {
                    mainNav.map((link) => (
                        <a
                            href={link.href}
                            class="text-sm font-medium text-ivory/60 hover:text-primary transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </nav>
            <div class="hidden md:block">
                <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener"
                    class="bg-cta-primary hover:brightness-110 text-ivory px-5 py-2.5 rounded-full text-sm font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
                >
                    Hablemos por WhatsApp
                </a>
            </div>
            <div class="md:hidden flex items-center">
                <button
                    id="mobile-menu-btn"
                    class="text-ivory/60 hover:text-ivory transition-colors p-2"
                    aria-label="Toggle mobile menu"
                >
                    <Icon
                        id="menu-icon-open"
                        name="ph:list"
                        class="w-6 h-6"
                    />
                    <Icon
                        id="menu-icon-close"
                        name="ph:x"
                        class="w-6 h-6 hidden"
                    />
                </button>
            </div>
        </div>
    </div>

    <div
        id="mobile-menu"
        class="absolute left-0 right-0 top-full md:hidden glass border-b border-primary/10 transition-all duration-300 origin-top opacity-0 pointer-events-none -translate-y-4"
    >
        <div class="px-4 pt-2 pb-6 space-y-2 shadow-2xl">
            {
                mainNav.map((link) => (
                    <a
                        href={link.href}
                        class="block px-4 py-3 rounded-xl text-base font-medium text-ivory/60 hover:text-ivory hover:bg-surface transition-colors mobile-link"
                    >
                        {link.label}
                    </a>
                ))
            }
            <a
                href={whatsappHref}
                target="_blank"
                rel="noopener"
                class="block px-4 py-3 mt-4 text-center rounded-xl bg-cta-primary shadow-cta-primary hover:shadow-cta-primary-hover hover:brightness-110 text-ivory text-base font-medium transition-all duration-300 mobile-link border border-primary/50"
            >
                Hablemos por WhatsApp
            </a>
        </div>
    </div>
</header>

<script>
    const initMobileMenu = () => {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        const iconOpen = document.getElementById("menu-icon-open");
        const iconClose = document.getElementById("menu-icon-close");
        const mobileLinks = document.querySelectorAll(".mobile-link");

        function toggleMenu() {
            if (!menu || !iconOpen || !iconClose) return;
            menu.classList.toggle("opacity-0");
            menu.classList.toggle("pointer-events-none");
            menu.classList.toggle("-translate-y-4");
            menu.classList.toggle("opacity-100");
            menu.classList.toggle("pointer-events-auto");
            menu.classList.toggle("translate-y-0");

            iconOpen.classList.toggle("hidden");
            iconClose.classList.toggle("hidden");
        }

        if (btn) {
            btn.addEventListener("click", toggleMenu);
        }

        mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
                if (!menu || !iconOpen || !iconClose) return;
                menu.classList.add(
                    "opacity-0",
                    "pointer-events-none",
                    "-translate-y-4",
                );
                menu.classList.remove(
                    "opacity-100",
                    "pointer-events-auto",
                    "translate-y-0",
                );

                iconOpen.classList.remove("hidden");
                iconClose.classList.add("hidden");
            });
        });
    };

    // astro:page-load only fires when View Transitions are enabled,
    // so listen for both that and the regular DOM ready event.
    document.addEventListener("astro:page-load", initMobileMenu);
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMobileMenu, {
            once: true,
        });
    } else {
        initMobileMenu();
    }
</script>
