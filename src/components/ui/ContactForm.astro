---
import { Icon } from "astro-icon/components";
import FormField from "@components/forms/FormField.astro";

interface Props {
    titulo?: string;
    subtitulo?: string;
    btnTexto?: string;
    className?: string;
    showHeader?: boolean;
    showPrivacy?: boolean;
}

const {
    titulo = "Hablemos",
    subtitulo = "Completa el formulario y te respondo en menos de 24 horas.",
    btnTexto = "Enviar mensaje",
    className = "",
    showHeader = true,
    showPrivacy = false,
} = Astro.props;
---

<div class:list={["contact-form-wrapper space-y-6", className]}>
    {
        showHeader && (
            <div>
                <h2 class="text-2xl md:text-3xl font-bold text-ivory font-heading">
                    {titulo}
                </h2>
                {subtitulo && (
                    <p class="mt-2 text-sm text-muted font-mono leading-relaxed">
                        {subtitulo}
                    </p>
                )}
            </div>
        )
    }

    <div
        id="cf-error"
        class="hidden rounded-xl border border-error/30 bg-error/10 p-4 text-sm text-error font-mono"
        role="alert"
        aria-live="polite"
    >
    </div>

    <form
        id="contact-form"
        name="contact"
        method="POST"
        action="/gracias/"
        data-netlify="true"
        data-netlify-honeypot="cf-website"
        novalidate
        class="space-y-6"
    >
        <input type="hidden" name="form-name" value="contact" />

        <p
            class="absolute opacity-0 pointer-events-none -left-[9999px]"
            aria-hidden="true"
        >
            <label for="cf-website">No completar este campo</label>
            <input
                id="cf-website"
                name="cf-website"
                type="text"
                tabindex="-1"
                autocomplete="off"
            />
        </p>

        <FormField
            name="nombre"
            label="Nombre"
            placeholder="Tu nombre completo"
            autocomplete="name"
            required
        />

        <FormField
            name="email"
            label="Email"
            type="email"
            placeholder="tu@email.com"
            autocomplete="email"
            required
        />

        <FormField
            name="mensaje"
            label="Mensaje"
            type="textarea"
            placeholder="Contame qué negocio tenés y en qué te puedo ayudar..."
            required
        />

        <button
            id="cf-submit"
            type="submit"
            class="w-full flex items-center justify-center gap-2 bg-cta-primary text-ivory px-8 py-4 rounded-btn text-lg font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:shadow-cta-primary-hover active:scale-[.99]"
        >
            <Icon
                id="cf-spinner"
                name="ph:spinner"
                class="hidden h-5 w-5 animate-spin shrink-0"
            />
            <span id="cf-btn-label">{btnTexto}</span>
            <Icon
                id="cf-send-icon"
                name="ph:paper-plane-tilt-fill"
                class="w-5 h-5 shrink-0"
            />
        </button>

        {
            showPrivacy && (
                <p class="text-sm text-muted text-center font-mono">
                    Al enviar este formulario, aceptás mi política de
                    privacidad.
                </p>
            )
        }
    </form>
</div>

<script>
    (() => {
        const form = document.getElementById(
            "contact-form",
        ) as HTMLFormElement | null;
        const btnSubmit = document.getElementById(
            "cf-submit",
        ) as HTMLButtonElement | null;
        const spinner = document.getElementById(
            "cf-spinner",
        ) as HTMLElement | null;
        const sendIcon = document.getElementById(
            "cf-send-icon",
        ) as HTMLElement | null;
        const btnLabel = document.getElementById(
            "cf-btn-label",
        ) as HTMLSpanElement | null;
        const elError = document.getElementById(
            "cf-error",
        ) as HTMLElement | null;

        if (!form || !btnSubmit || !btnLabel) return;

        const inputOk = ["border-ivory/20"];
        const inputErr = ["border-error"];

        function fieldError(id: string, msg: string) {
            const p = document.getElementById(id + "-error");
            const input = document.getElementById(
                id,
            ) as HTMLInputElement | null;
            if (!p || !input) return;
            p.textContent = msg;
            p.classList.toggle("hidden", !msg);
            input.classList.remove(...inputOk, ...inputErr);
            input.classList.add(...(msg ? inputErr : inputOk));
        }

        const setLoading = (loading: boolean) => {
            btnSubmit.disabled = loading;
            spinner?.classList.toggle("hidden", !loading);
            sendIcon?.classList.toggle("hidden", loading);
            btnLabel.textContent = loading
                ? "Enviando..."
                : btnLabel.dataset.original || "Enviar mensaje";
        };

        btnLabel.dataset.original = btnLabel.textContent;

        ["field-nombre", "field-email", "field-mensaje"].forEach((id) => {
            document
                .getElementById(id)
                ?.addEventListener("input", () => fieldError(id, ""));
        });

        form.addEventListener("submit", (e) => {
            const honeypot = (
                document.getElementById("cf-website") as HTMLInputElement | null
            )?.value;
            if (honeypot) return;

            const nombre =
                (
                    document.getElementById(
                        "field-nombre",
                    ) as HTMLInputElement | null
                )?.value.trim() ?? "";
            const email =
                (
                    document.getElementById(
                        "field-email",
                    ) as HTMLInputElement | null
                )?.value.trim() ?? "";
            const mensaje =
                (
                    document.getElementById(
                        "field-mensaje",
                    ) as HTMLTextAreaElement | null
                )?.value.trim() ?? "";

            let valid = true;
            if (!nombre) {
                fieldError("field-nombre", "El nombre es obligatorio.");
                valid = false;
            }
            if (!email) {
                fieldError("field-email", "El email es obligatorio.");
                valid = false;
            } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                fieldError("field-email", "Ingresá un email válido.");
                valid = false;
            }
            if (!mensaje) {
                fieldError("field-mensaje", "El mensaje no puede estar vacío.");
                valid = false;
            }

            if (!valid) {
                e.preventDefault();
                elError?.classList.remove("hidden");
                if (elError)
                    elError.textContent = "Revisá los campos marcados en rojo.";
                elError?.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                });
                return;
            }

            elError?.classList.add("hidden");
            setLoading(true);
        });
    })();
</script>
