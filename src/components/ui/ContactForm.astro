---
import { Icon } from "astro-icon/components";

/**
 * Formulario de contacto reutilizable (Astro + Tailwind + API PHP)
 *
 * PROPS (todas opcionales):
 *   apiUrl      → URL del backend PHP
 *   titulo      → Título del formulario
 *   subtitulo   → Subtítulo
 *   btnTexto    → Texto del botón enviar
 *   className   → Clases extra para el wrapper
 *   showHeader  → Mostrar encabezado (default: true)
 *   showPrivacy → Mostrar aviso de privacidad bajo el botón (default: false)
 */

interface Props {
  apiUrl?: string;
  titulo?: string;
  subtitulo?: string;
  btnTexto?: string;
  className?: string;
  showHeader?: boolean;
  showPrivacy?: boolean;
}

const {
  apiUrl = "/api/contacto.php",
  titulo = "Contáctanos",
  subtitulo = "Completa el formulario y te respondemos a la brevedad.",
  btnTexto = "Enviar mensaje",
  className = "",
  showHeader = true,
  showPrivacy = false,
} = Astro.props;

const inputClass =
  "w-full bg-void border border-primary/10 rounded-xl px-4 py-3 text-ivory placeholder-muted placeholder:font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all";

const labelClass = "block text-sm font-medium text-ivory/60";
---

<div class:list={["contact-form-wrapper space-y-6", className]}>
  {
    showHeader && (
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-ivory font-heading">
          {titulo}
        </h2>
        {subtitulo && (
          <p class="mt-2 text-sm text-muted font-mono leading-relaxed">
            {subtitulo}
          </p>
        )}
      </div>
    )
  }

  <div
    id="cf-success"
    class="hidden rounded-xl border border-success/30 bg-success/10 p-4 text-sm text-success font-mono"
    role="alert"
    aria-live="polite"
  >
  </div>
  <div
    id="cf-error"
    class="hidden rounded-xl border border-error/30 bg-error/10 p-4 text-sm text-error font-mono"
    role="alert"
    aria-live="polite"
  >
  </div>

  <form id="contact-form" novalidate class="space-y-6">
    <div class="space-y-2">
      <label for="cf-nombre" class={labelClass}>
        Nombre <span class="text-primary" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-nombre"
        name="nombre"
        type="text"
        required
        autocomplete="name"
        placeholder="Tu nombre completo"
        class={inputClass}
      />
      <p id="cf-nombre-error" class="hidden mt-1 text-xs text-error font-mono">
      </p>
    </div>

    <div class="space-y-2">
      <label for="cf-email" class={labelClass}>
        Email <span class="text-primary" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="tu@email.com"
        class={inputClass}
      />
      <p id="cf-email-error" class="hidden mt-1 text-xs text-error font-mono">
      </p>
    </div>

    <div class="space-y-2">
      <label for="cf-mensaje" class={labelClass}>
        Mensaje <span class="text-primary" aria-hidden="true">*</span>
      </label>
      <textarea
        id="cf-mensaje"
        name="mensaje"
        rows="4"
        required
        placeholder="Contame qué negocio tenés y en qué te puedo ayudar..."
        class:list={[
          inputClass,
          "resize-none min-h-[120px]",
        ]}></textarea>
      <p id="cf-mensaje-error" class="hidden mt-1 text-xs text-error font-mono">
      </p>
    </div>

    <button
      id="cf-submit"
      type="submit"
      class="w-full flex items-center justify-center gap-2 bg-cta-primary text-ivory px-8 py-4 rounded-xl text-lg font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:shadow-cta-primary-hover active:scale-[.99]"
    >
      <svg
        id="cf-spinner"
        class="hidden h-5 w-5 animate-spin shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
      <span id="cf-btn-label">{btnTexto}</span>
      <Icon
        id="cf-send-icon"
        name="ri:send-plane-fill"
        class="w-5 h-5 shrink-0"
      />
    </button>

    {
      showPrivacy && (
        <p class="text-sm text-muted text-center font-mono">
          Al enviar este formulario, aceptás nuestra política de privacidad.
        </p>
      )
    }
  </form>
</div>

<script define:vars={{ apiUrl }}>
  (() => {
    const form = document.getElementById("contact-form");
    const btnSubmit = document.getElementById("cf-submit");
    const spinner = document.getElementById("cf-spinner");
    const sendIcon = document.getElementById("cf-send-icon");
    const btnLabel = document.getElementById("cf-btn-label");
    const elSuccess = document.getElementById("cf-success");
    const elError = document.getElementById("cf-error");

    if (!form || !btnSubmit || !btnLabel) return;

    const inputOk = ["border-primary/10"];
    const inputErr = ["border-error"];

    function showMsg(el, msg) {
      [elSuccess, elError].forEach((e) => {
        if (!e) return;
        e.classList.add("hidden");
        e.textContent = "";
      });
      if (!el) return;
      el.textContent = msg;
      el.classList.remove("hidden");
      el.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function fieldError(id, msg) {
      const p = document.getElementById(id + "-error");
      const input = document.getElementById(id);
      if (!p || !input) return;
      p.textContent = msg;
      p.classList.toggle("hidden", !msg);
      input.classList.remove(...inputOk, ...inputErr);
      input.classList.add(...(msg ? inputErr : inputOk));
    }

    function setLoading(loading) {
      btnSubmit.disabled = loading;
      spinner?.classList.toggle("hidden", !loading);
      sendIcon?.classList.toggle("hidden", loading);
      btnLabel.textContent = loading
        ? "Enviando..."
        : btnLabel.dataset.original || "Enviar mensaje";
    }

    btnLabel.dataset.original = btnLabel.textContent;

    ["cf-nombre", "cf-email", "cf-mensaje"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", () =>
        fieldError(id, ""),
      );
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nombre = document.getElementById("cf-nombre")?.value.trim() ?? "";
      const email = document.getElementById("cf-email")?.value.trim() ?? "";
      const mensaje = document.getElementById("cf-mensaje")?.value.trim() ?? "";

      let valid = true;
      if (!nombre) {
        fieldError("cf-nombre", "El nombre es obligatorio.");
        valid = false;
      }
      if (!email) {
        fieldError("cf-email", "El email es obligatorio.");
        valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        fieldError("cf-email", "Ingresá un email válido.");
        valid = false;
      }
      if (!mensaje) {
        fieldError("cf-mensaje", "El mensaje no puede estar vacío.");
        valid = false;
      }
      if (!valid) return;

      setLoading(true);

      try {
        const res = await fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nombre, email, mensaje }),
        });

        const data = await res.json();

        if (data.ok) {
          showMsg(elSuccess, data.mensaje || "¡Mensaje enviado!");
          form.reset();
        } else {
          showMsg(
            elError,
            data.mensaje || "Ocurrió un error. Intentá de nuevo.",
          );
        }
      } catch {
        showMsg(
          elError,
          "No se pudo conectar con el servidor. Verificá tu conexión.",
        );
      } finally {
        setLoading(false);
      }
    });
  })();
</script>
