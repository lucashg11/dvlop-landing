---
import { siteConfig } from "../data/site";

const whatsappHref = `${siteConfig.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, vengo de tu web y quiero reservar 15 minutos para hablar de mi proyecto.")}`;
---

<section
  id="cta-banner"
  class="py-24 relative overflow-hidden reveal mt-10"
>
  <div class="absolute inset-0 bg-cta-violet -z-10"></div>
  <div
    class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[800px] h-[800px] bg-primary rounded-full blur-3xl opacity-50 -z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[600px] bg-accent/20 rounded-full blur-3xl opacity-50 -z-10"
  >
  </div>

  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2
      class="text-4xl md:text-5xl font-bold text-ivory mb-6 reveal font-heading"
    >
      Tu competencia ya tiene web. Vos todavía estás decidiendo.
    </h2>
    <p class="text-ivory/80 text-lg md:text-xl mb-10 text-balance max-w-2xl mx-auto">
      Reservá 15 minutos. Me contás qué necesitás, te digo si te puedo ayudar,
      y si sí te paso presupuesto sin compromiso.
    </p>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 bg-ivory text-primary hover:bg-ivory/90 px-8 py-4 rounded-full font-bold text-lg transition-transform hover:scale-105 shadow-xl"
    >
      Reservar mi llamada por WhatsApp
      <svg
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 8l4 4m0 0l-4 4m4-4H3"
        />
      </svg>
    </a>
    <p class="text-ivory/70 text-sm font-mono mt-6">
      Sin costo · Sin compromiso · Te respondo en menos de 24 horas
    </p>
  </div>
</section>
