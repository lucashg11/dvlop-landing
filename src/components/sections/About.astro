---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import aboutImage from "@assets/images/profile-3.png";
import { values } from "@data/about";
import { site } from "@config/site";

const features = [
    "+5 años diseñando sitios web que aparecen en Google",
    "Trabajo con Astro y React para sitios que cargan en menos de 3 segundos",
    "Entrega entre 7 y 25 días hábiles, según el alcance del proyecto",
    "Hablás directo conmigo por WhatsApp: sin gestores, sin intermediarios",
];

const whatsappHref = `${site.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, te escribo desde tu web. Quiero contarte brevemente qué necesito para mi negocio y ver si tiene sentido trabajar juntos.")}`;

const valueIconNames = ["ph:target", "ph:lightning", "ph:clock"];
---

<section id="about" class="py-section bg-void border-t border-primary/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="relative">
                <div
                    class="absolute inset-0 bg-primary rounded-3xl blur-3xl opacity-20 -z-10"
                >
                </div>
                <Image
                    src={aboutImage}
                    alt="Lucas, desarrollador web freelance en Zárate, Buenos Aires"
                    loading="lazy"
                    class="rounded-3xl shadow-2xl border border-primary/10 object-cover aspect-square w-full"
                />
                <div
                    class="absolute -bottom-6 -right-6 bg-surface border border-primary/10 p-6 rounded-2xl shadow-xl hidden sm:block"
                >
                    <div
                        class="text-4xl font-extrabold text-primary mb-1 font-display"
                    >
                        +5
                    </div>
                    <div class="text-ivory font-medium">
                        Años de experiencia
                    </div>
                </div>
            </div>

            <div>
                <p
                    class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
                >
                    Quién te va a responder
                </p>
                <h2
                    class="text-3xl md:text-5xl font-bold mb-6 font-heading"
                >
                    Hola, soy Lucas.
                </h2>
                <p class="text-lg text-ivory mb-6 leading-relaxed font-mono">
                    Soy Lucas, desarrollador web freelance en Zárate. Hace 5+
                    años ayudo a negocios a dejar de depender solo de redes y
                    aparecer en Google cuando alguien busca lo que hacen.
                </p>
                <p class="text-base text-muted mb-10 leading-relaxed font-mono">
                    Trabajo con Astro para sitios rápidos y con React/Node
                    cuando el proyecto necesita lógica más compleja (tiendas,
                    paneles, integraciones). Pero la tecnología es lo de menos:
                    lo que importa es que cada sitio resuelva un problema
                    concreto de tu negocio. Por eso antes de escribir una línea
                    de código, te escucho.
                </p>

                <div class="space-y-3 mb-10">
                    {
                        features.map((feature) => (
                            <div class="flex items-center gap-3">
                                <Icon
                                    name="ph:check"
                                    class="w-5 h-5 text-success shrink-0"
                                />
                                <span class="text-ivory font-mono text-sm">
                                    {feature}
                                </span>
                            </div>
                        ))
                    }
                </div>
                <div class="grid md:grid-cols-3 gap-4 mb-10 md:w-2xl">
                    {
                        values.map((value, i) => (
                            <div class="bg-surface border border-primary/10 rounded-2xl p-5 ">
                                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center mb-3">
                                    <Icon
                                        name={valueIconNames[i]}
                                        class="w-5 h-5 text-primary"
                                    />
                                </div>
                                <h3 class="text-base font-bold font-heading mb-2">
                                    {value.title}
                                </h3>
                                <p class="text-muted text-xs font-mono leading-relaxed">
                                    {value.description}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 bg-cta-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
                >
                    Hablemos por WhatsApp
                    <Icon name="ph:arrow-right" class="w-5 h-5" />
                </a>
            </div>
        </div>
    </div>
</section>
