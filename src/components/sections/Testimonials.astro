---
import { Icon } from "astro-icon/components";
import Section from "@components/sections/Section.astro";
import Badge from "@components/ui/Badge.astro";
import GradientText from "@components/ui/GradientText.astro";
import { testimonials } from "@data/testimonials";
---

<Section id="testimonials" tone="default">
    <div class="text-center max-w-3xl mx-auto mb-16">
        <Badge text="Lo que dicen mis clientes" variant="secondary" />
        <h2
            class="text-3xl md:text-5xl font-bold mt-4 mb-4 font-heading leading-tight"
        >
            Resultados <GradientText>medibles, no promesas.</GradientText>
        </h2>
        <p class="text-muted text-lg font-mono">
            Esto es lo que cambió en sus negocios en los meses después del
            lanzamiento, contadas por ellos.
        </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {
            testimonials.map((testimonial) => (
                <div class="bg-surface border border-primary/10 rounded-3xl p-8 flex flex-col">
                    <div class="mb-6">
                        <Icon
                            name="ph:quotes"
                            class="w-8 h-8 text-primary/40"
                        />
                    </div>
                    <blockquote class="text-ivory/90 text-base font-mono leading-relaxed mb-6 flex-1">
                        {testimonial.quote}
                    </blockquote>
                    <div class="border-t border-primary/10 pt-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-ivory font-semibold text-sm">
                                    {testimonial.name}
                                </p>
                                <p class="text-muted text-xs font-mono mt-0.5">
                                    {testimonial.role}
                                </p>
                            </div>
                            {testimonial.metric && (
                                <span class="text-success text-xs font-mono font-medium bg-success/10 border border-success/20 px-3 py-1 rounded-full">
                                    {testimonial.metric}
                                </span>
                            )}
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</Section>
