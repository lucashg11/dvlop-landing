---
import { Icon } from "astro-icon/components";
import { site } from "@config/site";

const whatsappHref = `${site.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, vengo de tu web y quiero reservar 15 minutos para hablar de mi proyecto.")}`;
---

<section id="cta-banner" class="py-section relative overflow-hidden mt-10">
    <div class="absolute inset-0 bg-cta-primary -z-10"></div>
    <div
        class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 w-[800px] h-[800px] bg-primary rounded-full blur-3xl opacity-50 -z-10"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[600px] bg-accent/20 rounded-full blur-3xl opacity-50 -z-10"
    >
    </div>

    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2
            class="text-4xl md:text-5xl font-bold text-ivory mb-6 font-heading"
        >
            Tu competencia ya tiene web. Vos todavía estás decidiendo.
        </h2>
        <p
            class="text-ivory/80 text-lg md:text-xl mb-10 text-balance max-w-2xl mx-auto"
        >
            Reservá 15 minutos. Me contás qué necesitás, te digo si te puedo
            ayudar, y si sí te paso presupuesto sin compromiso.
        </p>
        <a
            href={whatsappHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-ivory text-primary hover:bg-ivory/90 px-8 py-4 rounded-full font-bold text-lg transition-transform hover:scale-105 shadow-xl"
        >
            Reservá 15 min por WhatsApp
            <Icon name="ph:arrow-right" class="w-5 h-5" />
        </a>
        <p class="text-ivory/70 text-sm font-mono mt-6">
            Sin costo · Sin compromiso · Te respondo en menos de 24 horas
        </p>
    </div>
</section>
