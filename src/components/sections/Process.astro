---
import Badge from "../ui/Badge.astro";
import GradientText from "../ui/GradientText.astro";

const steps = [
  {
    number: "01",
    title: "Entendemos",
    description:
      "Hablamos por WhatsApp o videollamada. Me contás qué hacés, qué necesitás y qué esperás del proyecto. Sin compromiso, sin vueltas.",
    icon: "chat",
  },
  {
    number: "02",
    title: "Definimos",
    description:
      "Te presento una propuesta clara: alcance, plazo, presupuesto y qué entregás exactamente. Ajustamos lo que haga falta y arrancamos.",
    icon: "check",
  },
  {
    number: "03",
    title: "Construimos",
    description:
      "Diseño mobile-first, desarrollo en Astro, SEO desde la base, formularios funcionales. Te mantengo al tanto en cada etapa por WhatsApp.",
    icon: "code",
  },
  {
    number: "04",
    title: "Publicamos y acompañamos",
    description:
      "Subimos el sitio, configuramos dominio, Analytics y Search Console. Te explico cómo usarlo. Si querés, seguimos con mantenimiento mensual.",
    icon: "rocket",
  },
];

const stepIcons: Record<string, string> = {
  chat: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  check:
    "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  code: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  rocket:
    "M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z",
};
---

<section
  id="process"
  class="py-24 bg-surface border-t border-primary/10 reveal"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <Badge text="Metodología" variant="secondary" />
      <h2 class="text-3xl md:text-5xl font-bold mt-4 mb-4 font-heading leading-tight">
        Cómo <GradientText>trabajamos</GradientText> juntos
      </h2>
      <p class="text-muted text-lg font-mono">
        Desde el primer mensaje hasta el sitio funcionando. Sin procesos
        eternos ni jerga técnica.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connector line (desktop) -->
      <div
        class="hidden lg:block absolute top-24 left-[12.5%] right-[12.5%] h-px bg-linear-to-r from-primary/40 via-primary/20 to-primary/40"
      ></div>

      <div
        class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative"
      >
        {steps.map((step, i) => (
          <div
            class="relative flex flex-col items-center text-center group"
          >
            <!-- Number circle -->
            <div
              class="relative z-10 w-16 h-16 rounded-full bg-void border-2 border-primary/30 flex items-center justify-center mb-6 group-hover:border-primary transition-colors duration-300"
            >
              <span class="text-primary font-bold font-heading text-lg">
                {step.number}
              </span>
            </div>

            <!-- Icon -->
            <div
              class="w-11 h-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center mb-5"
            >
              <svg
                class="w-5 h-5 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={stepIcons[step.icon]}
                /></svg>
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold font-heading text-ivory mb-3">
              {step.title}
            </h3>
            <p class="text-muted font-mono text-sm leading-relaxed max-w-xs">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom note -->
    <div
      class="mt-16 text-center p-6 rounded-2xl bg-void border border-primary/10 max-w-2xl mx-auto"
    >
      <p class="text-muted font-mono text-sm">
        <span class="text-primary font-medium">Proyectos típicos:</span> sitio
        listo en 7 a 10 días hábiles. Sitios institucionales en 18 a 25 días.
      </p>
    </div>
  </div>
</section>
