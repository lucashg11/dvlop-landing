---
import { Icon } from "astro-icon/components";
import Section from "@components/sections/Section.astro";
import Badge from "@components/ui/Badge.astro";
import GradientText from "@components/ui/GradientText.astro";

const steps = [
    {
        number: "01",
        title: "Conversamos 15 minutos",
        description:
            "Por WhatsApp o videollamada. Me contás tu negocio, qué necesitás y qué resultado esperás. Sin compromiso: si veo que no te puedo ayudar, te lo digo.",
        icon: "ph:chat-circle-dots",
    },
    {
        number: "02",
        title: "Propuesta clara por escrito",
        description:
            "Te paso un documento con alcance, plazo, precio y entregables. Lo ajustamos las veces que haga falta. Recién arrancamos cuando me das el sí.",
        icon: "ph:check-circle",
    },
    {
        number: "03",
        title: "Construyo tu sitio",
        description:
            "Diseño responsive, desarrollo, SEO desde la base y formulario funcionando. Te voy mandando avances por WhatsApp, así sabés en qué estamos sin esperar a la entrega final.",
        icon: "ph:code",
    },
    {
        number: "04",
        title: "Lanzo y te acompaño",
        description:
            "Conecto dominio, Analytics y Search Console. Te explico cómo usar el panel. El mantenimiento mensual es opcional: si no lo necesitás, no lo pagás.",
        icon: "ph:rocket-launch",
    },
];
---

<Section id="process" tone="muted">
    <div class="text-center max-w-3xl mx-auto mb-16">
        <Badge text="Metodología" variant="secondary" />
        <h2
            class="text-3xl md:text-5xl font-bold mt-4 mb-4 font-heading leading-tight"
        >
            Así <GradientText>trabajamos juntos</GradientText>
        </h2>
        <p class="text-muted text-lg font-mono">
            Un proceso claro, de 4 pasos. Sabés qué pasa en cada momento,
            qué entregable te llega y cuándo.
        </p>
    </div>

    <div class="relative">
        <div
            class="hidden lg:block absolute top-24 left-[12.5%] right-[12.5%] h-px bg-linear-to-r from-primary/40 via-primary/20 to-primary/40"
        >
        </div>

        <div
            class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative"
        >
            {
                steps.map((step) => (
                    <div class="relative flex flex-col items-center text-center group">
                        <div class="relative z-10 w-16 h-16 rounded-full bg-void border-2 border-primary/30 flex items-center justify-center mb-6 group-hover:border-primary transition-colors duration-300">
                            <span class="text-primary font-bold font-heading text-lg">
                                {step.number}
                            </span>
                        </div>

                        <div class="w-11 h-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center mb-5">
                            <Icon
                                name={step.icon}
                                class="w-5 h-5 text-primary"
                            />
                        </div>

                        <h3 class="text-xl font-bold font-heading text-ivory mb-3">
                            {step.title}
                        </h3>
                        <p class="text-muted font-mono text-sm leading-relaxed max-w-xs">
                            {step.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>

    <div
        class="mt-16 text-center p-6 rounded-2xl bg-void border border-primary/10 max-w-2xl mx-auto"
    >
        <p class="text-muted font-mono text-sm">
            <span class="text-primary font-medium">Plazos típicos:</span> Landing
            en 7 a 10 días hábiles. Sitio institucional en 18 a 25. Cada fecha
            la confirmamos por escrito antes de empezar, sin sorpresas.
        </p>
    </div>
</Section>
