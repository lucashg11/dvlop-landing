---
import Badge from "../ui/Badge.astro";
import GradientText from "../ui/GradientText.astro";

const packages = [
  {
    id: "starter",
    name: "Starter",
    tagline: "Tu primer paso en internet",
    priceLabel: "Lanzamiento desde",
    price: "$450.000",
    monthly: null,
    monthlyLabel: null,
    highlight: false,
    badge: null,
    description:
      "Todo lo que necesitás para aparecer en Google y generar confianza desde el primer día.",
    includes: [
      { text: "Dominio .com.ar" },
      { text: "2 cuentas email corporativo" },
      { text: "Landing page — mobile-first" },
      { text: "SSL" },
      { text: "SEO on-page básico" },
      { text: "Google Analytics + Search Console" },
    ],
    notIncluded: ["Mantenimiento mensual", "SEO local recurrente"],
    cta: "Empezar con Starter",
    note: "Renovación de dominio anual a cargo del cliente.",
  },
  {
    id: "pro",
    name: "Pro",
    tagline: "Presencia profesional completa",
    priceLabel: "Lanzamiento desde",
    price: "$950.000",
    monthly: "$150.000",
    monthlyLabel: "/ mes",
    highlight: true,
    badge: "Más elegido",
    description:
      "Un sitio completo con alguien que lo cuida todos los meses y lo posiciona en Google.",
    includes: [
      { text: "Todo lo de Starter" },
      { text: "Sitio hasta 5 páginas en Astro" },
      { text: "3 cuentas email corporativo" },
      { text: "Mantenimiento mensual (4 cambios + backup)" },
      { text: "Reporte mensual de visitas" },
      { text: "SEO local (Google My Business + keywords)" },
      { text: "Reporte SEO mensual" },
    ],
    notIncluded: ["Funcionalidades dinámicas (React)"],
    cta: "Elegir Pro",
    note: "Contrato mínimo de 3 meses en la mensualidad.",
  },
  {
    id: "premium",
    name: "Premium",
    tagline: "Dominá tu mercado local",
    priceLabel: "Lanzamiento desde",
    price: "$1.800.000",
    monthly: "$300.000",
    monthlyLabel: "/ mes",
    highlight: false,
    badge: null,
    description:
      "La solución completa para negocios que quieren liderar su categoría en Google.",
    includes: [
      { text: "Todo lo de Pro" },
      { text: "React para funcionalidades dinámicas" },
      { text: "5 cuentas email corporativo" },
      { text: "Cloudflare Workers disponible" },
      { text: "Mantenimiento completo (8 cambios + soporte prioritario)" },
      { text: "SEO agresivo — más keywords y backlinks" },
      { text: "Reporte SEO detallado mensual" },
    ],
    notIncluded: [],
    cta: "Elegir Premium",
    note: "Incluye consultoría inicial de 45 minutos sin cargo.",
  },
];
---

<section id="pricing" class="py-24 bg-void border-t border-primary/10 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <Badge text="Paquetes de servicio" variant="secondary" />
      <h2 class="text-3xl md:text-5xl font-bold mb-4 reveal font-heading">
        Todo lo que tu negocio necesita,
        <GradientText>en un solo paquete.</GradientText>
      </h2>
      <p class="text-muted text-lg font-mono">
        Dominio, sitio web, email corporativo, mantenimiento y SEO. Sin lidiar
        con múltiples proveedores ni sorpresas.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid lg:grid-cols-3 gap-6 lg:gap-4 items-stretch">
      {
        packages.map((pkg) => (
          <div
            class:list={[
              "relative flex flex-col rounded-3xl border transition-all duration-300",
              pkg.highlight
                ? "bg-primary/5 border-primary/40 shadow-[0_0_60px_rgba(234,88,12,0.12)] lg:scale-105 z-10"
                : "bg-surface border-primary/10 hover:border-primary/25",
            ]}
          >
            <!-- Badge popular -->
            {pkg.badge && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center gap-1.5 bg-primary text-ivory text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full shadow-[0_0_20px_rgba(234,88,12,0.5)]">
                  <span class="w-1.5 h-1.5 rounded-full bg-ivory/80 animate-pulse" />
                  {pkg.badge}
                </span>
              </div>
            )}

            <div class="p-8 flex flex-col gap-6 h-full">

              <!-- Name + tagline -->
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <span
                    class:list={[
                      "text-2xl font-bold font-heading",
                      pkg.highlight ? "text-primary" : "text-ivory",
                    ]}
                  >
                    {pkg.name}
                  </span>
                </div>
                <p class="text-muted text-sm font-mono">{pkg.tagline}</p>
              </div>

              <!-- Price -->
              <div
                class:list={[
                  "rounded-2xl p-5 border",
                  pkg.highlight
                    ? "bg-primary/10 border-primary/20"
                    : "bg-void border-primary/10",
                ]}
              >
                <p class="text-xs uppercase tracking-widest text-muted font-mono mb-1">
                  {pkg.priceLabel}
                </p>
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl font-bold font-heading text-ivory">
                    {pkg.price}
                  </span>
                  <span class="text-muted text-sm font-mono">ARS</span>
                </div>
                {pkg.monthly && (
                  <div class="mt-3 pt-3 border-t border-primary/10 flex items-baseline gap-1">
                    <span class="text-primary font-bold text-xl font-heading">
                      {pkg.monthly}
                    </span>
                    <span class="text-muted text-sm font-mono">
                      {pkg.monthlyLabel}
                    </span>
                    <span class="text-muted text-xs font-mono ml-1">
                      mantenimiento + SEO
                    </span>
                  </div>
                )}
                {!pkg.monthly && (
                  <p class="mt-3 text-xs text-muted font-mono">
                    Sin mensualidad obligatoria
                  </p>
                )}
              </div>

              <!-- Description -->
              <p class="text-ivory/70 text-sm font-mono leading-relaxed">
                {pkg.description}
              </p>

              <!-- Includes -->
              <div class="flex-1">
                <p class="text-xs uppercase tracking-widest text-muted font-mono mb-3">
                  Incluye
                </p>
                <ul class="space-y-2.5">
                  {pkg.includes.map((item) => (
                    <li class="flex items-start gap-3">
                      <svg
                        class="w-4 h-4 text-primary mt-0.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      <span class="text-ivory/80 text-sm font-mono">
                        {item.text}
                      </span>
                    </li>
                  ))}
                  {pkg.notIncluded.map((item) => (
                    <li class="flex items-start gap-3 opacity-40">
                      <svg
                        class="w-4 h-4 text-muted mt-0.5 shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 18L18 6M6 6l12 12"
                        />
                      </svg>
                      <span class="text-muted text-sm font-mono line-through">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Note -->
              {pkg.note && (
                <p class="text-xs text-muted font-mono border-t border-primary/10 pt-4">
                  * {pkg.note}
                </p>
              )}

              <!-- CTA -->
              <a
                href="/contact"
                class:list={[
                  "mt-auto flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-medium text-sm transition-all",
                  pkg.highlight
                    ? "bg-cta-violet text-ivory shadow-[0_0_20px_rgba(234,88,12,0.3)] hover:shadow-[0_0_30px_rgba(234,88,12,0.5)]"
                    : "bg-void border border-primary/20 text-ivory hover:bg-primary/10 hover:border-primary/40",
                ]}
              >
                {pkg.cta}
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Footer note -->
    <p class="text-center text-muted text-sm font-mono mt-10">
      ¿No sabés cuál elegir? <a
        href="/contact"
        class="text-primary hover:underline underline-offset-4"
        >Contame tu negocio y te recomiendo el que más te conviene.</a
      >
    </p>

    <!-- Custom project CTA -->
    <div
      class="mt-16 p-10 lg:p-12 rounded-3xl border border-primary/10 bg-surface text-center max-w-3xl mx-auto"
    >
      <div
        class="w-14 h-14 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="w-7 h-7 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M11.42 15.17l-5.645 3.063.85-4.948a.5.5 0 00-.145-.424l-3.822-3.724 5.282-.768a.5.5 0 00.378-.274L11.42 3.422l2.362 4.787a.5.5 0 00.378.274l5.282.768-3.822 3.724a.5.5 0 00-.145.424l.85 4.948-5.645-3.063a.5.5 0 00-.424 0z"
          />
        </svg>
      </div>
      <h3 class="text-2xl md:text-3xl font-bold font-heading text-ivory mb-4">
        ¿Necesitás algo a medida?
      </h3>
      <p class="text-muted font-mono text-base max-w-lg mx-auto mb-8 leading-relaxed">
        Si tu proyecto combina varios servicios, requiere funcionalidades
        específicas o simplemente querés una propuesta
        <strong class="text-ivory">hecha desde cero para tu negocio</strong>,
        armamos un paquete personalizado sin costo adicional.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-cta-violet text-ivory px-8 py-4 rounded-full font-bold text-base transition-all shadow-[0_0_20px_rgba(234,88,12,0.3)] hover:shadow-[0_0_30px_rgba(234,88,12,0.5)] hover:scale-105"
      >
        Consultá tu proyecto personalizado
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          />
        </svg>
      </a>
    </div>
  </div>
</section>