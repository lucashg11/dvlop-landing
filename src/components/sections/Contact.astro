---
import { Icon } from "astro-icon/components";
import Section from "@components/sections/Section.astro";
import Badge from "@components/ui/Badge.astro";
import GradientText from "@components/ui/GradientText.astro";
import ContactForm from "@components/ui/ContactForm.astro";
import { site } from "@config/site";

const contactData = [
    {
        id: "whatsapp",
        title: "WhatsApp (canal principal)",
        description: site.phone,
        link: site.whatsappUrl,
        icon: "ph:phone-fill",
    },
    {
        id: "email",
        title: "Correo electrónico",
        description: site.email,
        link: `mailto:${site.email}`,
        icon: "ph:envelope-simple-fill",
    },
    {
        id: "location",
        title: "Ubicación",
        description: `${site.address[0]}, ${site.address[1]} · Trabajo presencial en Zárate y zona norte de Buenos Aires, y remoto para todo el país`,
        icon: "ph:map-pin-fill",
    },
];
---

<Section id="contact" tone="default" class="relative overflow-hidden">
    <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,var(--tw-gradient-stops))] from-primary/20 via-surface to-surface -z-10"
    >
    </div>

    <!-- CTA de urgencia (antes era un banner separado) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
            <Badge text="Último paso: hablemos" variant="secondary" />
            <h2
                class="text-4xl md:text-5xl font-bold text-ivory mt-4 mb-6 font-heading"
            >
                Tu competencia ya tiene web. Vos todavía está <GradientText
                    >decidiendo.</GradientText
                >
            </h2>
            <p
                class="text-ivory/80 text-lg md:text-xl mb-6 text-balance max-w-2xl mx-auto font-mono"
            >
                Mientras vos lo pensás, otros negocios de tu mismo rubro ya
                están recibiendo consultas por Google. Reservá 15 minutos: me
                contás qué necesitás, te digo si te puedo ayudar, y si sí te
                paso presupuesto por escrito sin compromiso.
            </p>
            <p class="text-muted font-mono text-sm">
                ★ Respuesta en menos de 24 horas · +5 años de experiencia ·
                Garantía 30 días en cada proyecto
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-16">
            <div>
                <h3
                    class="text-2xl md:text-3xl font-bold mb-6 font-heading text-ivory"
                >
                    Te respondo en <GradientText
                        >menos de 24 horas.</GradientText
                    >
                </h3>
                <p
                    class="text-lg text-muted mb-10 leading-relaxed max-w-lg font-mono"
                >
                    Todas las consultas me llegan a mí, sin formularios eternos
                    ni gestor de proyectos. Hablás directo con quien te va a
                    construir la web.
                </p>

                <div class="space-y-8">
                    {
                        contactData.map((contact) => (
                            <div class="flex items-start gap-4 group">
                                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                                    <Icon
                                        name={contact.icon}
                                        class="w-6 h-6 text-primary"
                                    />
                                </div>
                                <div>
                                    <h3 class="text-ivory font-medium mb-1 text-lg">
                                        {contact.title}
                                    </h3>
                                    {contact.id === "location" ? (
                                        <p class="text-muted font-mono">
                                            {contact.description}
                                        </p>
                                    ) : (
                                        <a
                                            href={contact.link}
                                            class="text-muted font-mono hover:text-primary transition-colors"
                                        >
                                            {contact.description}
                                        </a>
                                    )}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div
                class="bg-surface p-8 md:p-10 rounded-3xl border border-primary/10 shadow-2xl relative"
            >
                <div
                    class="absolute -top-24 -right-24 w-48 h-48 bg-primary/30 rounded-full blur-3xl pointer-events-none"
                >
                </div>

                <ContactForm
                    showHeader={false}
                    showPrivacy={true}
                    btnTexto="Enviar mensaje"
                    className="relative z-10"
                />
                <p
                    class="text-muted font-mono text-xs text-center mt-4 relative z-10"
                >
                    Te respondo en menos de 24 horas hábiles. Sin compromiso.
                </p>
            </div>
        </div>
</Section>
