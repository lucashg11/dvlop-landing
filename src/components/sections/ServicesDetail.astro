---
import { Image } from "astro:assets";
import { ICONS } from "../../data/icons";
import GradientText from "../ui/GradientText.astro";
import Badge from "../ui/Badge.astro";
import type { Service } from "../../data/services";
import { siteConfig } from "../../data/site";

export interface Props {
  services: Service[];
}
const { services } = Astro.props;

const whatsappHref = `${siteConfig.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, vengo de tu web y quiero contarte sobre un proyecto.")}`;

const categoryLabels: Record<Service["category"], string> = {
  presencia: "Presencia web",
  automatizacion: "Automatización",
  ecommerce: "Ecommerce",
  nicho: "Solución de nicho",
  recurrente: "Servicio recurrente",
};
---

<main id="main" class="pt-32 pb-24">
  <section
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16 reveal"
  >
    <p
      class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
    >
      Lo que ofrezco
    </p>
    <h1
      class="text-5xl md:text-7xl font-extrabold mb-6 reveal font-display"
      transition:name="services-title"
    >
      Servicios para <GradientText>aparecer en Google</GradientText>
    </h1>
    <p class="text-xl text-muted max-w-3xl mx-auto font-mono">
      12 productos digitales diseñados para resolver problemas concretos de tu
      negocio. Precio fijo, plazo fijo, garantía 30 días por escrito.
    </p>
  </section>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal"
  >
    <div class="flex flex-wrap justify-center gap-3">
      {
        Array.from(new Set(services.map((s) => s.category))).map((cat) => (
          <a
            href={`#${cat}`}
            class="px-4 py-2 rounded-full bg-surface border border-primary/20 text-sm font-mono text-ivory/80 hover:border-primary/50 hover:text-primary transition-colors"
          >
            {categoryLabels[cat]}
          </a>
        ))
      }
    </div>
  </div>

  <div class="space-y-32">
    {
      services.map((service, index) => {
        const isEven = index % 2 === 0;
        const Icon = ICONS[service.icon];

        return (
          <section
            id={service.id}
            data-category={service.category}
            class="scroll-mt-40 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 group reveal"
          >
            <div class="grid lg:grid-cols-2 gap-16 items-center">
              <div class={!isEven ? "lg:order-2" : "lg:order-1"}>
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  <div class="inline-flex items-center gap-3 px-4 py-2 rounded-xl bg-primary/10 border border-primary/20 text-primary group-hover:bg-primary/20 transition-colors">
                    {Icon && <Icon class="w-5 h-5" />}
                    <span class="font-semibold tracking-wide uppercase text-sm font-heading">
                      {categoryLabels[service.category]}
                    </span>
                  </div>
                  {service.recurring && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-accent/10 border border-accent/20 text-accent text-xs font-mono">
                      ↻ Recurrente
                    </span>
                  )}
                </div>

                <h2 class="text-3xl md:text-4xl font-bold mb-4 group-hover:text-primary transition-colors reveal font-heading">
                  {service.title}
                </h2>
                <p class="text-base text-muted mb-6 leading-relaxed font-mono">
                  {service.shortDescription}
                </p>
                <p class="text-base text-ivory/80 mb-8 leading-relaxed font-mono">
                  {service.descriptionFull}
                </p>

                <div
                  class="grid sm:grid-cols-2 gap-3 mb-8 p-5 rounded-2xl bg-surface border border-primary/10"
                >
                  <div>
                    <p class="text-xs uppercase tracking-widest text-muted font-mono mb-1">
                      Precio
                    </p>
                    <p class="text-xl font-bold font-heading text-ivory">
                      {service.basePrice}
                    </p>
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-widest text-muted font-mono mb-1">
                      Plazo de entrega
                    </p>
                    <p class="text-base font-mono text-ivory">
                      {service.deliveryTime}
                    </p>
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-3 mb-10">
                  {service.features.map((feature) => (
                    <div class="flex items-start gap-2">
                      <svg
                        class="w-5 h-5 text-success shrink-0 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                      <span class="text-ivory/80 text-sm font-mono">
                        {feature}
                      </span>
                    </div>
                  ))}
                </div>

                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 bg-cta-primary text-ivory px-7 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
                >
                  {service.cta}
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              </div>

              <div
                class={`relative ${!isEven ? "lg:order-1" : "lg:order-2"}`}
              >
                <div class="absolute inset-0 bg-primary rounded-3xl blur-3xl opacity-20 -z-10 group-hover:opacity-40 transition-opacity duration-700" />
                <div class="overflow-hidden rounded-3xl border border-primary/10 shadow-2xl">
                  <Image
                    src={service.image}
                    alt={service.title}
                    loading={service.loading}
                    class="w-full object-cover aspect-video lg:aspect-square transform group-hover:scale-105 transition-transform duration-700 ease-out"
                  />
                </div>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>
</main>
