---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Badge from "@components/ui/Badge.astro";
import GradientText from "@components/ui/GradientText.astro";
import type { Project } from "@data/projects";
import { site } from "@config/site";

export interface Props {
    projects: Project[];
}
const { projects } = Astro.props;
---

<section id="work" class="py-section bg-surface border-t border-primary/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6"
        >
            <div class="max-w-2xl">
                <Badge text="Trabajos realizados" variant="secondary" />
                <h2 class="text-3xl md:text-5xl font-bold font-heading">
                    Sitios que <GradientText>aparecen en Google</GradientText> y traen
                    consultas.
                </h2>
                <p class="text-muted font-mono mt-4">
                    Algunos proyectos recientes. Problema concreto, solución
                    concreta, resultado medible.
                </p>
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
            {
                projects.slice(0, 4).map((project) => (
                    <div class="group block relative rounded-3xl overflow-hidden">
                        <div class="aspect-4/3 overflow-hidden relative">
                            <div class="absolute inset-0 bg-void/20 group-hover:bg-transparent transition-colors z-10 duration-500" />
                            <Image
                                src={project.image}
                                alt={project.title}
                                loading={project.loading}
                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
                            />
                        </div>
                        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 bg-linear-to-t from-void via-void/80 to-transparent z-20 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-primary font-medium mb-2 text-sm">
                                        {project.category}
                                    </p>
                                    <h3 class="text-2xl font-bold text-ivory group-hover:text-accent transition-colors font-heading">
                                        {project.title}
                                    </h3>
                                </div>
                                <div class="w-12 h-12 rounded-full bg-card-depth flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-50 group-hover:scale-100 transition-all duration-300">
                                    <Icon name="ph:arrow-right" class="w-6 h-6 text-ivory" />
                                </div>
                            </div>
                        </div>
                        <div class="p-5 bg-surface border-t border-primary/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-error/70 font-mono mb-1">
                                        Problema
                                    </p>
                                    <p class="text-ivory/80 text-sm font-mono leading-snug line-clamp-2">
                                        {project.problem}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-success/70 font-mono mb-1">
                                        Resultado
                                    </p>
                                    <p class="text-ivory/80 text-sm font-mono leading-snug line-clamp-2">
                                        {project.results}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-12 text-center p-6 rounded-2xl bg-void border border-primary/10 max-w-2xl mx-auto"
        >
            <p class="text-ivory font-mono">
                ¿Tu negocio puede ser el próximo caso?{" "}
                <a
                    href={site.whatsappUrl}
                    class="text-primary hover:underline underline-offset-4"
                    >Hablemos por WhatsApp →</a
                >
            </p>
        </div>
    </div>
</section>
