---
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";
import "@fontsource-variable/space-grotesk/wght.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource/dm-mono/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  hasFaq?: boolean;
}

const {
  title,
  description = "Soy Lucas, desarrollador web en Zárate, Buenos Aires. Creo sitios responsivos, rápidos y posicionados en Google para emprendedores, PyMEs y negocios locales que quieren presencia digital que funcione de verdad.",
  image,
  noindex = false,
  hasFaq = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ea580c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <SEO title={title} description={description} image={image} hasFaq={hasFaq} />
    <ClientRouter />
  </head>
  <body
    class="bg-void text-ivory antialiased selection:bg-primary selection:text-ivory"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-ivory focus:px-4 focus:py-2 focus:rounded-full focus:font-mono focus:text-sm"
    >
      Saltar al contenido principal
    </a>
    <slot />
  </body>  <script>
    document.addEventListener("astro:page-load", () => {
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const revealAll = () => {
        document
          .querySelectorAll(".reveal:not(.reveal-visible)")
          .forEach((el) => el.classList.add("reveal-visible"));
      };

      if (prefersReduced) {
        revealAll();
        return;
      }

      const observerOptions = {
        root: null,
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.05,
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-visible");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll(".reveal").forEach((el) => {
        observer.observe(el);
      });

      setTimeout(revealAll, 3500);
    });
  </script>
</html>
