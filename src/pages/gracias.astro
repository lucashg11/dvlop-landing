---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site";

const whatsappHref = `${siteConfig.whatsappUrl}?text=${encodeURIComponent("Hola Lucas, te acabo de enviar un mensaje desde el formulario de tu web.")}`;
---

<Layout
  title="Mensaje enviado — Lucas Dev"
  description="Gracias por escribirme. Te respondo en menos de 24 horas."
  noindex={true}
>
  <Header />

  <main id="main" class="pt-40 pb-24 min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div
        class="w-20 h-20 rounded-full bg-success/10 border-2 border-success/30 flex items-center justify-center mx-auto mb-8"
      >
        <svg
          class="w-10 h-10 text-success"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <p
        class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
      >
        Mensaje enviado
      </p>
      <h1
        class="text-4xl md:text-6xl font-extrabold mb-6 font-display tracking-tight"
      >
        Listo, <span class="text-primary">lo tengo.</span>
      </h1>
      <p
        class="text-lg text-muted font-mono mb-10 max-w-xl mx-auto leading-relaxed"
      >
        Te respondo en menos de 24 horas. Si tenés alguna urgencia, escribime
        directo por WhatsApp.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 bg-cta-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M21 16.42v3.05a1 1 0 0 1-1.1 1 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.2 2.77 1 1 0 0 1 3.18 1.7h3a1 1 0 0 1 1 .75 11.5 11.5 0 0 0 .57 2.57 1 1 0 0 1-.23 1L6.21 7.21a16 16 0 0 0 6 6l1.18-1.18a1 1 0 0 1 1-.23 11.5 11.5 0 0 0 2.57.57 1 1 0 0 1 .75 1Z"
            />
          </svg>
          Escribirme por WhatsApp
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 bg-surface hover:bg-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all border border-primary/20"
        >
          Volver al inicio
        </a>
      </div>

      <p class="text-sm text-muted font-mono">
        Tu mensaje fue recibido. Si en 24hs no recibiste respuesta, revisá tu
        carpeta de spam o escribime directo.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
