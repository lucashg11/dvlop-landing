---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
---

<Layout
    title="404 — Página no encontrada · Lucas Dev"
    description="La página que buscás no existe. Volvé al inicio o contactame por WhatsApp."
    noindex={true}
>
    <Header />

    <main id="main" class="pt-40 pb-24 min-h-[70vh] flex items-center">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p
                class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
            >
                Error 404
            </p>
            <h1
                class="text-6xl md:text-8xl font-extrabold mb-6 font-display tracking-tight"
            >
                <span class="text-primary">404</span>
            </h1>
            <p class="text-2xl md:text-3xl font-bold mb-4 font-heading">
                Esta página no existe (todavía).
            </p>
            <p
                class="text-lg text-muted font-mono mb-10 max-w-xl mx-auto leading-relaxed"
            >
                Puede ser que la URL esté mal escrita, que movimos el contenido,
                o que nunca existió. Te dejo opciones para encontrar lo que
                buscás.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="/"
                    class="inline-flex items-center justify-center gap-2 bg-cta-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all shadow-cta-primary hover:shadow-cta-primary-hover"
                >
                    Volver al inicio
                    <Icon name="ph:arrow-right" class="w-5 h-5" />
                </a>
                <a
                    href="/#work"
                    class="inline-flex items-center justify-center gap-2 bg-surface hover:bg-primary text-ivory px-8 py-3.5 rounded-full font-medium transition-all border border-primary/20"
                >
                    Ver trabajos
                </a>
            </div>
        </div>
    </main>

    <Footer />
</Layout>
