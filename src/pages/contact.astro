---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactForm from "../components/ui/ContactForm.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site";

const contactData = [
  {
    title: "Escribime un correo",
    description: siteConfig.email,
    link: `mailto:${siteConfig.email}`,
    icon: "ri:mail-fill",
  },
  {
    title: "WhatsApp",
    description: siteConfig.phone,
    link: siteConfig.whatsappUrl,
    icon: "ri:phone-fill",
  },
  {
    title: "Ubicación",
    description: `${siteConfig.address[0]}, ${siteConfig.address[1]}`,
    icon: "ri:map-pin-fill",
  },
];
---

<Layout
  title="Contacto — Lucas Dev"
  description="Hablemos de tu proyecto. Te respondo en menos de 24 horas por WhatsApp, email o formulario. Sin compromiso."
>
  <Header />

  <main id="main" class="pt-32 pb-24">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
      <p
        class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
      >
        Hablemos
      </p>
      <h1
        class="text-5xl md:text-6xl font-extrabold mb-6 reveal font-display"
      >
        Te respondo en
        <span class="text-primary">menos de 24 horas</span>
      </h1>
      <p class="text-xl text-muted max-w-3xl mx-auto reveal font-mono">
        Contame qué negocio tenés, qué problemas tiene y juntos pensamos si
        una web te sirve. Sin compromiso, sin formularios eternos.
      </p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <p
            class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
          >
            Canales
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6 font-heading">
            Elegí el canal que prefieras
          </h2>
          <p class="text-muted font-mono mb-10 max-w-lg">
            Directo conmigo, sin formularios eternos, sin intermediarios.
          </p>

          <div class="space-y-8">
            {
              contactData.map((contact) => (
                <div class="flex items-start gap-4 group">
                  <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                    <svg
                      class="w-6 h-6 text-primary"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      {contact.icon === "ri:mail-fill" && (
                        <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.5L3.5 6.5h17L12 12.5ZM4 8.4V18h16V8.4l-7.5 5.7a1 1 0 0 1-1 0L4 8.4Z" />
                      )}
                      {contact.icon === "ri:phone-fill" && (
                        <path d="M21 16.42v3.05a1 1 0 0 1-1.1 1 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.2 2.77 1 1 0 0 1 3.18 1.7h3a1 1 0 0 1 1 .75 11.5 11.5 0 0 0 .57 2.57 1 1 0 0 1-.23 1L6.21 7.21a16 16 0 0 0 6 6l1.18-1.18a1 1 0 0 1 1-.23 11.5 11.5 0 0 0 2.57.57 1 1 0 0 1 .75 1Z" />
                      )}
                      {contact.icon === "ri:map-pin-fill" && (
                        <path d="M12 2a8 8 0 0 0-8 8c0 5.4 7 11.5 7.3 11.7a1 1 0 0 0 1.4 0c.3-.2 7.3-6.3 7.3-11.7a8 8 0 0 0-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" />
                      )}
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-ivory font-medium mb-1 text-lg">
                      {contact.title}
                    </h3>
                    {contact.link ? (
                      <a
                        href={contact.link}
                        class="text-muted font-mono hover:text-primary transition-colors"
                      >
                        {contact.description}
                      </a>
                    ) : (
                      <p class="text-muted font-mono">{contact.description}</p>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="bg-surface p-8 md:p-10 rounded-3xl border border-primary/10 shadow-2xl relative"
        >
          <p
            class="text-primary font-mono text-sm font-medium mb-4 uppercase tracking-widest"
          >
            O escribime acá
          </p>
          <h2 class="text-2xl font-bold mb-6 font-heading">Mensaje directo</h2>
          <ContactForm
            showHeader={false}
            showPrivacy={true}
            btnTexto="Enviar mensaje"
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
